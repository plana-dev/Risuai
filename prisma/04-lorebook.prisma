

// ============================================
// 4. 로어북
// ============================================

model Lorebook {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  characterId       String?  @map("character_id") @db.Uuid
  chatId            String?  @map("chat_id") @db.Uuid
  
  name              String?  @db.VarChar(255)
  key               String   @db.Text
  secondKey         String?  @map("second_key") @db.Text
  content           String   @db.Text
  comment           String?  @db.Text
  
  // 설정
  mode              String   @default("normal") @db.VarChar(50) // 'multiple'|'constant'|'normal'|'child'|'folder'
  insertOrder       Int      @default(0) @map("insert_order")
  alwaysActive      Boolean  @default(false) @map("always_active")
  selective         Boolean  @default(false)
  useRegex          Boolean  @default(false) @map("use_regex")
  activationPercent Int?     @map("activation_percent")
  
  // 확장 (JSONB)
  extensions        Json?
  loreCache         Json?    @map("lore_cache")
  folder            String?  @db.VarChar(255)
  bookVersion       Int?     @map("book_version")
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  // Relations
  character         Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  chat              Chat?      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  @@map("lorebooks")
  @@index([characterId])
  @@index([chatId])
  // Note: Gin 인덱스는 마이그레이션에서 수동으로 추가 필요
  // CREATE INDEX lorebooks_key_gin_idx ON lorebooks USING gin (key gin_trgm_ops);
}
